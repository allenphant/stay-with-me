rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSpaceMember(appId, spaceId) {
      return signedIn() && exists(
        /databases/$(database)/documents/artifacts/$(appId)/spaces/$(spaceId)/members/$(request.auth.uid)
      );
    }

    function isPersonalBootstrap(appId, spaceId) {
      return signedIn() && request.auth.uid == spaceId && !exists(
        /databases/$(database)/documents/artifacts/$(appId)/spaces/$(spaceId)
      );
    }

    match /artifacts/{appId}/spaces/{spaceId} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSpaceMember(appId, spaceId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }
    }

    match /artifacts/{appId}/spaceInvites/{inviteId} {
      allow read, write: if false;
    }

    // Memberships are written only by trusted Callable Functions. A user may
    // list only their own memberships to discover spaces they can open.
    match /artifacts/{appId}/users/{userId}/memberships/{spaceId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Couple-life data with money or privacy implications is written only by
    // trusted Callable Functions. The client can read the shared feature
    // state, but it cannot mint tokens, change prices, or reveal diary text.
    match /artifacts/{appId}/users/{spaceId}/tokens/wallets/{uid} {
      allow read: if isSpaceMember(appId, spaceId) && request.auth.uid == uid;
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/tokens/ledger/{ledgerId} {
      allow read: if isSpaceMember(appId, spaceId) && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/dailyQuestions/{document=**} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/diaries/{diaryId} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/diaries/{diaryId}/content/{document=**} {
      allow read: if isSpaceMember(appId, spaceId) && (
        get(/databases/$(database)/documents/artifacts/$(appId)/users/$(spaceId)/diaries/$(diaryId)).data.authorUid == request.auth.uid ||
        exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(spaceId)/diaries/$(diaryId)/unlocks/$(request.auth.uid))
      );
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/diaries/{diaryId}/unlocks/{uid} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/weeklyReviews/{document=**} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;
    }

    match /artifacts/{appId}/users/{spaceId}/whiteboardBlocks/{document=**} {
      allow read, write: if isSpaceMember(appId, spaceId);
    }

    match /artifacts/{appId}/users/{spaceId}/pets/{petId} {
      allow read: if isSpaceMember(appId, spaceId);
      allow write: if false;
    }

    // Existing card paths are retained for a no-copy migration: a space ID is
    // also the data-root ID. Personal space IDs equal their owner's UID.
    match /artifacts/{appId}/users/{spaceId}/{collectionName}/{document=**} {
      allow read, write: if collectionName != "memberships" &&
        collectionName != "tokens" &&
        collectionName != "dailyQuestions" &&
        collectionName != "diaries" &&
        collectionName != "weeklyReviews" &&
        collectionName != "whiteboardBlocks" &&
        collectionName != "pets" &&
        (isSpaceMember(appId, spaceId) || isPersonalBootstrap(appId, spaceId));
    }

    // Automation settings are private to the account that schedules work.
    match /artifacts/{appId}/automationUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
