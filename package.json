{
  "name": "my-ai-brain",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs functions/test/*.test.js",
    "test:functions": "node --test functions/test/*.test.js",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "cloud:enable-apis": "bash scripts/enable-cloud-apis.sh",
    "emulators": "firebase emulators:start --only functions,firestore --project dating-with-viola",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules --project dating-with-viola"
  },
  "devDependencies": {
    "firebase-tools": "^15.24.0"
  }
}
